# Server-only. Set these in Vercel Settings > Environment Variables > Production.
# The public Apps Script deployment URL must end in /exec, not /dev.
GOOGLE_SHEETS_WEB_APP_URL=
# Same random secret as SHARED_SECRET in Google Apps Script Script Properties.
# Use 32-256 characters. Never paste a real secret into Git, chat or NEXT_PUBLIC_.
GOOGLE_SHEETS_SHARED_SECRET=
