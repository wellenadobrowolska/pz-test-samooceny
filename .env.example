# Server-only. Set in Vercel Settings > Environment Variables > Production.
# Create the API token in MailerLite > Integrations > MailerLite API.
# Never use NEXT_PUBLIC_ for this token and never commit its real value.
MAILERLITE_API_KEY=
# Numeric ID of the MailerLite group for self-assessment test signups.
MAILERLITE_GROUP_ID=
